@misc{cuzzoneGreenlandIceSheet2026,
  title = {Greenland {{Ice Sheet}} to Fall below Its {{Holocene}} Minimum Size by 2300},
  author = {Cuzzone, Joshua and Briner, Jason and Otiniano, Gerard and Truax, Olivia and Thomas, Elizabeth and Steig, Eric and Hakim, Gregory and Tulenko, Joseph and Morlighem, Mathieu and Schlegel, Nicole-Jeanne and Nowicki, Sophie and Acharya, Sudip and Anderson, Jacob and Caron, Lambert and De Vernal, Anne and Downs, Jacob and {Folie-Boivin}, Emilie and Fleetwood, Ryan and Han, Holly Kyeore and Johnson, Jesse and Larour, Eric and Luzardi, Ana Carolina and Meng, Zilu and Prince, Karlee and Schaefer, Joerg and Turrin, Margie and Wilson, Liza and Wu, Xiner and Young, Nicolas},
  year = 2026,
  publisher = {In Review},
  address = {Nature Communications},
  doi = {10.21203/rs.3.rs-9962320/v1},
  urldate = {2026-09-14},
  abstract = {Abstract                        The Greenland Ice Sheet (GrIS) is a major contributor to sea-level rise, yet its long-term response to sustained warmth remains uncertain             1,2,3             . The Holocene represents the most recent interval during which the GrIS experienced centuries of temperatures above preindustrial levels, providing a natural benchmark for assessing its sensitivity to prolonged warming             4,5             . However, reproducing the geologically constrained evolution of the GrIS throughout the Holocene has remained a persistent challenge for ice-sheet models             6,7             . Here we present GrIS simulations forced by paleoclimate reconstructions and evaluated against extensive geological constraints to reconstruct its evolution from the Holocene to 2300 CE. By simultaneously capturing multiple independent records of past ice-sheet change, our ensemble provides a robust foundation for future projections. Under current warming trajectories, the GrIS shrinks below its Holocene minimum extent and volume by 2300 CE, while mass loss rates exceed Holocene maxima and contribute 26--86 cm of sea-level equivalent. Continued warming drives a nonlinear expansion of the ablation zone beyond its Holocene range, whereas substantial emissions reductions limit the sea-level contribution to approximately 10 cm. These results indicate that future warming may push the Greenland Ice Sheet beyond the range of states experienced during the Holocene.},
  archiveprefix = {In Review},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  filename = {Cuzzone2026},
  keywords = {in_review},
  file = {/Users/gerard/Library/Mobile Documents/com~apple~CloudDocs/Zotero/Cuzzone et al. - 2026 - Greenland Ice Sheet to fall below its Holocene minimum size by 2300.pdf}
}

@misc{otinianoCoherentRegionalExpressions2026,
  title = {Coherent Regional Expressions of {{Holocene}} Summer Temperature on {{Greenland}}},
  author = {Otiniano, Gerard A. and Thomas, Elizabeth K. and Truax, Olivia J. and Steig, Eric J. and De Vernal, Anne and Acharya, Sudip and Briner, Jason P. and Cuzzone, Joshua K. and Mark, Sam Z. and Hakim, Greg},
  year = 2026,
  month = oct,
  publisher = {Proxy Use-Development-Validation/Terrestrial Archives/Holocene},
  address = {Climate of the Past},
  doi = {10.5194/egusphere-2026-5983},
  urldate = {2026-10-22},
  abstract = {Abstract. Proxy time series suggest that Holocene summer warmth peaked asynchronously across Greenland, but the extent to which these differences reflect coherent regional climate patterns remains unclear. We compile 38 quantitative and qualitative summer-temperature proxy time series from Greenland and adjacent seas and apply an uncertainty-weighted factor analysis framework that accommodates heterogeneous proxy types to identify coherent temporal and spatial patterns from 10 ka to present. We compare these proxy-derived factors with those for five proxy-informed paleoclimate reconstructions and a transient model-only baseline. Two factors best represent the proxy network. The leading temporal mode reaches a maximum by 7.2 ka, reflecting early-to-mid Holocene warmth in northern and eastern Greenland, and contrasts with delayed warming in western Greenland. We interpret this pattern as an insolation-driven summer-temperature response modified by meltwater, ocean stratification, and sea-ice dynamics during retreat of the Laurentide and Greenland ice sheets. The second temporal mode peaks by 5.4 ka and is strongest in southern and southwestern Greenland, which may reflect an increased coastal influence of Atlantic-origin heat transported by the Irminger and West Greenland currents. Climate reconstructions reproduce the temporal evolution of the proxy-derived factors more successfully than their spatial patterns. Two paleoclimate reconstructions provide the closest agreement, but no existing reconstruction reproduces the complete regional structure of the proxy network. Despite proxy and chronological uncertainties, this analysis demonstrates that heterogeneous proxies can resolve coherent spatiotemporal patterns in Holocene Greenland climate, providing a basis for mechanistic interpretation and an empirical benchmark for evaluating paleoclimate reconstructions.},
  archiveprefix = {Proxy Use-Development-Validation/Terrestrial Archives/Holocene},
  copyright = {https://creativecommons.org/licenses/by/4.0/},
  filename = {Otiniano2026},
  langid = {english},
  file = {/Users/gerard/Library/Mobile Documents/com~apple~CloudDocs/Zotero/Otiniano et al. - 2026 - Coherent regional expressions of Holocene summer temperature on Greenland.pdf}
}

